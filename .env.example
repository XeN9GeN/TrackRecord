# Copy to .env and adjust. Never commit .env.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
DATABASE_URL=postgres://trackrecord:password@localhost:5432/trackrecord
MEDIA_ROOT=./media

# Docker Compose uses these values for the db container and builds DATABASE_URL
# with the service name `db`. Use a strong password for a deployed instance.
POSTGRES_DB=trackrecord
POSTGRES_USER=trackrecord
POSTGRES_PASSWORD=change-me

# Public deployment over HTTPS (docs/DEPLOY.md):
# DEBUG=False
# ALLOWED_HOSTS=1-2-3-4.sslip.io
# CSRF_TRUSTED_ORIGINS=https://1-2-3-4.sslip.io
# SECURE_COOKIES=True
